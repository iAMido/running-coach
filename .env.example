# NextAuth
NEXTAUTH_SECRET=your-secret-here  # Generate with `bunx openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter AI (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-api-key

# Strava OAuth (https://developers.strava.com)
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
NEXT_PUBLIC_STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# intervals.icu (https://intervals.icu/settings -> Developer Settings)
INTERVALS_API_KEY=your-intervals-api-key
INTERVALS_ATHLETE_ID=iXXXXXX
# Encrypts intervals_tokens.api_key at rest. That key grants WRITE access to the
# athlete's training calendar, and the service role bypasses RLS — so RLS is not
# what protects it. 32 bytes: `openssl rand -base64 32`
INTERVALS_TOKEN_KEY=your-32-byte-base64-key

# Cron (Vercel Cron authenticates with `Bearer ${CRON_SECRET}`)
CRON_SECRET=your-cron-secret
